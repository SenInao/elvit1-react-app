    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-router-dom": "^6.27.0",
    "react-icons": "^5.3.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^3.1.0",
    "nodemon": "^1.19.4",
    "vite": "^4.5.5",
